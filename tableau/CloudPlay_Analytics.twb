    <datasource caption='Custom SQL Query (cloudplay) (3)' inline='true' name='federated.0l84ib907qg2gl1ffcf5i129cj13' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='localhost' name='postgres.1c6cmwk1e85yif10nhnr909apvqb'>
            <connection authentication='username-password' class='postgres' dbname='cloudplay' one-time-sql='' port='5432' server='localhost' username='postgres' />
          </named-connection>
        </named-connections>
        <relation connection='postgres.1c6cmwk1e85yif10nhnr909apvqb' name='Custom SQL Query' type='text'>with journey_status as (&#13;
    select&#13;
        journey_id,&#13;
        max(&#13;
            case&#13;
                when gaming_session_id is not null then 1&#13;
                else 0&#13;
            end&#13;
        ) as success&#13;
    from product_events&#13;
    group by journey_id&#13;
)&#13;
select&#13;
    case&#13;
        when success = 1 then &apos;Converted&apos;&#13;
        else &apos;Abandoned&apos;&#13;
    end as journey_status,&#13;
    count(*) as journeys&#13;
from journey_status&#13;
group by success</relation>
        <metadata-records>
          <metadata-record class='column'>
            <remote-name>journey_status</remote-name>
            <remote-type>129</remote-type>
