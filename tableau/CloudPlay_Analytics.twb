          </named-connection>
        </named-connections>
        <relation connection='postgres.0lsmbl209srztg18bg03b15s4dsq' name='Custom SQL Query' type='text'>with first_subscription as (&#13;
    select&#13;
        min(s.subscription_start_date) as first_month,&#13;
        user_id&#13;
    from subscriptions s&#13;
    group by user_id&#13;
),&#13;
new_subscriber as (&#13;
    select &#13;
        date_trunc(&apos;month&apos;, f_s.first_month) as mth_s,&#13;
        count(distinct f_s.user_id) as new_subscribers&#13;
    from first_subscription f_s&#13;
    group by mth_s&#13;
),&#13;
paymentss as (&#13;
    select&#13;
        date_trunc(&apos;month&apos;, p.payment_date) as mth_p,&#13;
        count(distinct p.user_id) as paying_users,&#13;
        count(p.payment_id) as successful_payments,&#13;
        sum(p.amount) as revenue&#13;
    from payments p&#13;
    where p.payment_status = &apos;successful&apos;&#13;
    group by mth_p&#13;
)&#13;
select&#13;
    ns.mth_s as mth,&#13;
    ns.new_subscribers,&#13;
    ps.paying_users,&#13;
    ps.successful_payments,&#13;
    ps.revenue&#13;
from new_subscriber ns&#13;
join paymentss ps&#13;
    on ns.mth_s = ps.mth_p</relation>
