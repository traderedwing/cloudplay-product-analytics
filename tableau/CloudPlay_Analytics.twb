        <relation connection='postgres.0jojh6y0zjtdky1bl2hls1hvuz5l' name='Custom SQL Query' type='text'>select&#13;
    u.acquisition_channel,&#13;
    count(distinct p.user_id) as paying_users,&#13;
    sum(p.amount) as revenue,&#13;
    round(&#13;
        sum(p.amount) / count(distinct p.user_id),&#13;
        2&#13;
    ) as rppu&#13;
from payments p&#13;
join users u&#13;
    on p.user_id = u.user_id&#13;
where p.payment_status = &apos;successful&apos;&#13;
group by u.acquisition_channel&#13;
order by revenue desc</relation>
